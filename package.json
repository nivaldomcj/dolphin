{
  "name": "dolphin",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "import": "bun src/scripts/import.ts",
    "seed:demo": "DOLPHIN_DB=demo.db DOLPHIN_DEMO=1 DOLPHIN_CONFIG=dolphin.config.example.ts bun src/scripts/seed-demo.ts",
    "demo": "DOLPHIN_DB=demo.db DOLPHIN_DEMO=1 DOLPHIN_CONFIG=dolphin.config.example.ts PORT=4750 bun src/server/index.ts",
    "backup": "bun src/scripts/backup.ts",
    "check:private": "bun src/scripts/check-private.ts",
    "prepare": "bun src/scripts/install-hooks.ts",
    "typecheck": "bun check",
    "test": "bun test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "kysely": "^0.29.9",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.65.1",
    "@testing-library/preact": "^3.2.6",
    "@types/bun": "^1.4.4",
    "bun-plugin-tailwind": "^0.1.2",
    "daisyui": "^5.8.1",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5"
  },
  "license": "MIT"
}
