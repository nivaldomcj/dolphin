#!/bin/sh
# dolphin hook: bun install replaces this file; it never replaces a hook without this line.
set -e
# Branches made before the scan existed have no script to run.
if [ -f src/scripts/check-private.ts ]; then
  bun src/scripts/check-private.ts --staged
fi
# Lint and format check on the staged files. Branches without Biome skip it.
if [ -x node_modules/.bin/biome ] && [ -f biome.json ]; then
  node_modules/.bin/biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true
fi
